# Template. Copy to .env.development (dev) or .env.production (local prod build).
# Both are gitignored — nothing here is committed with real values.
# CI supplies these from repo Variables/Secrets; see .github/workflows/deploy.yml.

VITE_BACKEND_BASE_URL='your backend base url here'
VITE_BACKEND_API_URL='your backend api url here'
VITE_PARTYKIT_SERVER_URL='your partykit server url here'
VITE_CLIENT_URL='your client url here'

# Google Picker API key. Ships in the client bundle by design, so it is only as
# safe as its Google Cloud Console restrictions — set an HTTP referrer
# restriction and limit it to the Picker/Drive APIs.
VITE_DEVELOPER_KEY='your developer key here'

VITE_USE_MOCK_API='false' # Set to true to use mock API instead of real WebSocket connection
