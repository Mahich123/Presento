{
  "name": "my-hono-workspace",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "bun run --cwd apps/server dev",
    "dev:frontend": "bun run --cwd apps/client dev",
    "dev:all": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "build": "bun run --cwd apps/server build && bun run --cwd apps/client build",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "bun-types": "^1.3.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7"
  },
  "dependencies": {
    "aie": "^1.1.1",
    "bad-words": "^4.0.0",
    "better-auth": "^1.3.33",
    "hono": "^4.10.4",
    "nanoid": "^5.1.6",
    "partysocket": "1.1.6"
  }
}
